{
  "name": "snotel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm exec -w @snotel/core -- tsc --noEmit",
    "ios": "npm run ios -w mobile",
    "mobile": "npm run start -w mobile",
    "refresh-snapshots": "tsx scripts/refresh-snapshots.ts",
    "build-spot-icons": "tsx scripts/build-spot-icons.ts",
    "test": "tsx --test packages/core/test/*.test.ts apps/web/test/*.test.ts",
    "refresh-forecasts": "tsx scripts/refresh-forecasts.ts"
  },
  "devDependencies": {
    "mapshaper": "^0.7.98",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15"
  }
}
